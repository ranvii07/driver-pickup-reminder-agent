# --- Google Sheet ---------------------------------------------------------
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=Rides
SERVICE_ACCOUNT_FILE=service_account.json

# --- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Trial accounts can only dial numbers you have verified in the Twilio
# console. Set this to your own verified number and every reminder is
# redirected there instead of the driver's real number. Leave it blank to
# dial the numbers in the sheet.
TEST_OVERRIDE_NUMBER=

# On a TRIAL account this must be set: trial accounts reject inline TwiML.
# Create a TwiML Bin (see README setup step 4) and paste its URL here.
# On an upgraded account, leave it blank to send TwiML inline instead.
TWIML_URL=

# --- Behaviour ------------------------------------------------------------
TIMEZONE=Asia/Kolkata
LEAD_MINUTES=30
DEFAULT_COUNTRY_CODE=+91

# true = do everything except actually dial (sheet is still updated)
DRY_RUN=false

# Seconds to wait for a call to reach a final state before we stop watching.
CALL_POLL_SECONDS=60

LOG_FILE=reminders.log
